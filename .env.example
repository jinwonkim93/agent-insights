# Native Ollama. Generation and embedding can use different providers/endpoints.
AI_DATABASE_URL=sqlite:///./agent-insights.db
AI_GENERATION_PROVIDER=ollama
AI_GENERATION_URL=http://127.0.0.1:11434
AI_GENERATION_MODEL=gemma3:4b
AI_GENERATION_API_KEY=
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_URL=http://127.0.0.1:11434
AI_EMBEDDING_MODEL=embeddinggemma
AI_EMBEDDING_API_KEY=
# Required for non-loopback binding. A service-level token, NOT per-tenant auth.
AI_API_KEY=
AI_HOST=127.0.0.1
AI_PORT=8766
AI_MAX_TOPICS_PER_BOT=128
AI_CLUSTERER=complete_link
# Optional: umap_hdbscan, after installing .[umap]
# For vLLM/OpenAI-compatible servers, configure each provider as openai:
# AI_GENERATION_PROVIDER=openai
# AI_GENERATION_URL=http://127.0.0.1:8000/v1
# AI_GENERATION_MODEL=your-served-chat-model
# AI_EMBEDDING_PROVIDER=openai
# AI_EMBEDDING_URL=http://127.0.0.1:8001/v1
# AI_EMBEDDING_MODEL=your-served-embedding-model
